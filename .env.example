# Secrets
DISCORD_TOKEN=replace-me
RIOT_API_TOKEN=replace-me

# Public RSO website used only to create one-time links. The bot does not load RSO credentials.
# Use legacy_icon until Riot supplies the RSO client. Switching to rso does not
# require replacing the rest of the bot.
VERIFICATION_MODE=legacy_icon
RSO_PUBLIC_BASE_URL=https://moonporo.pl
RSO_SESSION_TTL_SECONDS=600
RSO_COMPLETION_INTERVAL_SECONDS=3

# PostgreSQL (same VM by default)
POSTGRES_USER=moon_poro
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=moon_poro
DATABASE_POOL_SIZE=3
DATABASE_MAX_OVERFLOW=2

# Discord installation
GUILD_ID=0
WARN_CHANNEL_ID=0
ZWERYFIKOWANI_CHANNEL_ID=0
KOMENDY_BOTOWE_CHANNEL_ID=0
MOD_ALERT_CHANNEL_ID=0
SZUKANIE_GRY_CHANNEL_ID=0

# Stable role bindings. Prefer IDs over names in production.
# The keys must match configured role names exactly.
ROLE_IDS={}

# Core feature switches
VERIFICATION_ENABLED=true
ROLES_ENABLED=true
WARNINGS_ENABLED=true
MOD_STATS_ENABLED=true
MEMBER_LOGS_ENABLED=true

# Optional policies; disabled by default to avoid surprising bans and privileged intents.
ACCOUNT_AGE_GATE_ENABLED=false
MINIMUM_ACCOUNT_AGE_DAYS=90
BOOST_ALERT_ENABLED=false
CLASH_FILTER_ENABLED=false

# Timing
VERIFICATION_TIMEOUT=120
VERIFICATION_COOLDOWN=30
VERIFICATION_ICON_CHECK_COOLDOWN=5
VERIFICATION_GLOBAL_RATE_LIMIT=4
VERIFICATION_GLOBAL_RATE_PERIOD_SECONDS=10
RANK_REFRESH_INTERVAL_HOURS=24
RANK_REFRESH_WORKER_INTERVAL_SECONDS=10
RANK_REFRESH_RETRY_BASE_SECONDS=300
RANK_REFRESH_CLAIM_TIMEOUT_SECONDS=300
VERIFICATION_ACCESS_LOG_RETENTION_DAYS=90
VERIFICATION_SESSION_RETENTION_DAYS=7
PRIVACY_POLICY_URL=https://moonporo.pl/privacy/
