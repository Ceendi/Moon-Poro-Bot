---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  lang="en"
  canonicalPath="/oauth2/callback"
  title="Riot sign-in"
  description="Return address for signing in with Riot to Moon Poro."
>
  <section class="center">
    <img src="/moon-poro.png" alt="" width="96" height="96" />
    <h1>Riot sign-in isn't available yet</h1>
    <p class="lead">This is the return address for signing in with Riot. It will start working once Riot sign-in launches. Until then, verify on Discord by changing your profile icon.</p>
    <div class="actions"><a class="button" href="/en/#how">How to verify</a></div>
  </section>
</BaseLayout>
