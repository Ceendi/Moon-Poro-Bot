---
import "../styles/global.css";
import { siteConfig } from "../config";

interface Props {
  title: string;
  description: string;
  lang?: "pl" | "en";
  canonicalPath?: string;
}

const { title, description, lang = "pl", canonicalPath = Astro.url.pathname } = Astro.props;
const isEnglish = lang === "en";
const home = isEnglish ? "/en/" : "/";
const nav = isEnglish
  ? [
      ["How it works", "/en/#how"],
      ["Privacy", "/en/privacy/"],
      ["Terms", "/en/terms/"],
    ]
  : [
      ["Jak to działa", "/#jak"],
      ["Prywatność", "/privacy/"],
      ["Warunki", "/terms/"],
    ];
const languageHref = canonicalPath === "/404/" || canonicalPath === "/404"
  ? "/en/"
  : isEnglish ? canonicalPath.replace(/^\/en/, "") || "/" : `/en${canonicalPath}`;
const canonical = new URL(canonicalPath, siteConfig.siteUrl);
const image = new URL("/moon-poro.png", siteConfig.siteUrl);
const fullTitle = `${title} · Moon Poro`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#b9a3f5" />
    <meta name="color-scheme" content="dark" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Moon Poro" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/moon-poro.png" />
    <link rel="preload" href="/fonts/nunito-latin.woff2" as="font" type="font/woff2" crossorigin />
    <title>{fullTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">{isEnglish ? "Skip to content" : "Przejdź do treści"}</a>
    <header class="site-header">
      <a class="brand" href={home}>
        <img src="/moon-poro.png" alt="" width="40" height="40" />
        <span>Moon Poro</span>
      </a>
      <nav aria-label={isEnglish ? "Main navigation" : "Główna nawigacja"}>
        {nav.map(([label, href]) => (
          <a href={href} aria-current={Astro.url.pathname === href ? "page" : undefined}>{label}</a>
        ))}
        <a class="language" href={languageHref} hreflang={isEnglish ? "pl" : "en"} lang={isEnglish ? "pl" : "en"}>
          {isEnglish ? "PL" : "EN"}
        </a>
      </nav>
    </header>
    <main id="content"><slot /></main>
    <footer class="site-footer">
      <div class="footer-row">
        <p>{isEnglish ? `Made by ${siteConfig.operatorDisplayName} for the League of Legends PL server.` : `Zrobione przez ${siteConfig.operatorDisplayName} dla serwera League of Legends PL.`}</p>
        <div class="footer-links">
          <a href={isEnglish ? "/en/privacy/" : "/privacy/"}>{isEnglish ? "Privacy" : "Prywatność"}</a>
          <a href={isEnglish ? "/en/terms/" : "/terms/"}>{isEnglish ? "Terms" : "Warunki"}</a>
          <a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a>
        </div>
      </div>
      <p class="riot-disclaimer" lang="en">Moon Poro Bot isn't endorsed by Riot Games and doesn't reflect the views or opinions of Riot Games or anyone officially involved in producing or managing Riot Games properties. Riot Games, and all associated properties are trademarks or registered trademarks of Riot Games, Inc.</p>
    </footer>
  </body>
</html>
