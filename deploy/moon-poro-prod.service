[Unit]
Description=Moon Poro production bot
Wants=network-online.target
After=network-online.target postgresql-moon-poro-prod.service
Requires=postgresql-moon-poro-prod.service
StartLimitIntervalSec=300
StartLimitBurst=3
# Only after systemd gives up on restarts; a deploy or reboot stop is not a failure.
OnFailure=moon-poro-prod-alert@%n.service

[Service]
Type=simple
User=moon-poro-prod
Group=moon-poro-prod
WorkingDirectory=/opt/moon-poro-prod
EnvironmentFile=/etc/moon-poro/prod-bot.env
Environment=MOON_PORO_LOG_FILE=/var/log/moon-poro-prod/discord.log
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/moon-poro-prod/.venv/bin/python /opt/moon-poro-prod/main.py
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
UMask=0077
LogsDirectory=moon-poro-prod

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/log/moon-poro-prod
TasksMax=64
MemoryHigh=320M
MemoryMax=400M

StandardOutput=journal
StandardError=journal
SyslogIdentifier=moon-poro-prod

[Install]
WantedBy=multi-user.target
