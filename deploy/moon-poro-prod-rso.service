[Unit]
Description=Moon Poro Riot Sign On callback (production checkout)
After=network-online.target postgresql.service moon-poro-prod.service
Wants=network-online.target
# The callback only crashes at start on bad settings or code, so after five
# quick restarts systemd gives up and sends the alert instead of looping.
StartLimitIntervalSec=300
StartLimitBurst=5
OnFailure=moon-poro-prod-alert@%n.service

[Service]
Type=simple
User=moon-poro-rso
Group=moon-poro-rso
WorkingDirectory=/opt/moon-poro-prod
EnvironmentFile=/etc/moon-poro/prod-rso.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/moon-poro-prod/.venv/bin/python /opt/moon-poro-prod/rso_main.py
Restart=on-failure
RestartSec=3
# aiohttp waits up to 60 s for in-flight Riot callbacks before it exits.
TimeoutStopSec=75
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProcSubset=pid
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
MemoryHigh=96M
MemoryMax=128M

[Install]
WantedBy=multi-user.target
