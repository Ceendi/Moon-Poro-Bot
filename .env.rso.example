# This file belongs to the isolated moon-poro-rso service account.
# Do not add DISCORD_TOKEN or RIOT_API_TOKEN here.

# A dedicated PostgreSQL login is recommended; grant it access only to
# verification_links and verification_sessions.
POSTGRES_USER=moon_poro_rso
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=moon_poro
DATABASE_POOL_SIZE=1
DATABASE_MAX_OVERFLOW=1
GUILD_ID=0

# Riot supplies these values after approving the RSO client.
RSO_CLIENT_ID=replace-after-riot-approval
RSO_CLIENT_AUTH_METHOD=private_key_jwt
RSO_CLIENT_ASSERTION=replace-after-riot-approval
# For an older client configured by Riot for Client Secret Basic instead:
# RSO_CLIENT_AUTH_METHOD=client_secret_basic
# RSO_CLIENT_SECRET=replace-after-riot-approval

RSO_PUBLIC_BASE_URL=https://moonporo.pl
RSO_SCOPE="openid cpid"
RSO_ALLOWED_PLATFORMS=["EUN1","EUW1","NA1"]
RSO_SESSION_TTL_SECONDS=600
RSO_HTTP_TIMEOUT_SECONDS=10
RSO_HOST=127.0.0.1
RSO_PORT=8080
